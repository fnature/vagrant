# Vagrantfile

Vagrant.configure("2") do |config|

    # Define VM configurations in an array of hashes
    vms = [
        # Make sure wlp1s0 is your eth interface on the host for briding !
        # Chech the ips are within the subnet of your local host network because we use bridge interfaces
        { name: "debian1", ip: "192.168.1.201", hostname: "debian1", interface: "wlp1s0" },
        { name: "debian2", ip: "192.168.1.202", hostname: "debian2", interface: "wlp1s0" }#,
        #{ name: "debian3", ip: "192.168.1.203", hostname: "debian3", interface: "wlp1s0" },
        #{ name: "debian4", ip: "192.168.1.204", hostname: "debian4", interface: "wlp1s0" }
    ]

    # Build the /etc/hosts entries dynamically
    hosts = vms.map { |vm| "#{vm[:ip]} #{vm[:hostname]}" }.join("\n")

    # Iterate over the vms array to define each VM
    vms.each do |vm|
        config.vm.define vm[:name] do |debian|

            debian.vm.box = "bento/debian-12"  # Replace with correct Debian 12 box
            debian.vm.hostname = vm[:hostname]  # Set hostname dynamically
            debian.vm.network "public_network", ip: vm[:ip], bridge: vm[:interface] # Set IP dynamically # Specify the bridge interface  

            debian.vm.provider "virtualbox" do |vb|
                vb.memory = "4096"
                vb.cpus = 2
            end

        end
    end

    # Optional provisioning (e.g., to install basic utilities)
    config.vm.provision "shell", inline: <<-SHELL
        echo "#{hosts}" | sudo tee -a /etc/hosts
        sudo apt-get update
        sudo apt-get install -y curl wget vim snapd

        # Add the kubectl alias to ~/.bash_aliases to prevent conflicts
        echo "alias kubectl='microk8s kubectl'" >> ~/.bash_aliases

    SHELL

end
